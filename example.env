# Claude on the bedrock-mantle endpoint is not served from ap-south-1 (404 model not found).
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
CLAUDE_MODEL=anthropic.claude-opus-4-8
ENV=prod
RUNMODE=dev
NUMBER_OF_RETAILERS=2
NUMBER_OF_IMAGES=5
NUMBER_OF_FLYERS=2
DATABASE_URL=postgresql+psycopg://souq_ai:souq_ai@localhost:5432/souq_ai
